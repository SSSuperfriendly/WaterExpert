{
  "title": "WaterExpert 数据层登记表",
  "description": "data/ 与 outputs/ 中每个文件的登记去向。对应 docs/reviews/2026-08-28-data-layer-review.md 的第一步（建立登记表）与第二步（导入 DatasetService）。可执行清单见 scripts/data/register_baseline_datasets.py 的 MANIFEST。",
  "updated_at": "2026-08-28",
  "conventions": {
    "disposition": {
      "fact_source": "原始事实输入，保留在 data/ 作为可复现基线源，经 ingest_source_path 登记",
      "reference": "人工维护的站点/排除清单，经 register_derived_file(kind=reference) 登记",
      "derived": "由事实源派生的加工/融合宽表，经 register_derived_file(kind=derived) 登记，不作为可修改事实源",
      "proxy": "代理数据（非实测），经 register_derived_file(kind=proxy) 登记，任何展示须带“代理数据”标识",
      "fact_source_field": "现场监测明细，经 register_derived_file(kind=fact_source) 登记",
      "task_result": "任务输出（模型比较/预测/摘要），不作为数据资产登记",
      "media": "UAV 缩略图与视频帧，来源不完整、不可完全重建",
      "delete": "模板/静态清单/目录摘要，已被 version 元数据替代，删除",
      "bootstrap_source": "登记时被标准化 version 替代的原始文件，保留以支持干净环境重新登记"
    }
  },
