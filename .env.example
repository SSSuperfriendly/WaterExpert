# WaterExpert environment configuration (review item 25).
#
# Copy to `.env` and fill in before `docker compose up`. Every value has a safe
# local default except the secrets you must set for a non-demo deployment.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Secrets (set these in production; the defaults are only safe for a demo)
# ---------------------------------------------------------------------------
# JWT signing secret. If unset the app generates and persists one under
# `var/state/jwt_secret`; set it explicitly so tokens survive across redeploys.
WATEREXPERT_JWT_SECRET=
# Token lifetime in seconds (default 3600).
WATEREXPERT_JWT_LIFETIME_SECONDS=3600

# Demo account. When WATEREXPERT_DEMO_PASSWORD is unset, a random password is
# generated at first seed and printed once to the server log.
WATEREXPERT_DEMO_USERNAME=2510709
WATEREXPERT_DEMO_PASSWORD=
WATEREXPERT_DEMO_EMAIL=2510709@example.com
WATEREXPERT_DEMO_DISPLAY_NAME=AI4S Demo User
WATEREXPERT_DEMO_ROLE=reviewer

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Expose /api/v1/auth/hint (returns demo credentials). Off by default.
WATEREXPERT_ENABLE_DEMO_HINT=0

# GitHub OAuth (optional; the OAuth router is mounted only when both are set).
WATEREXPERT_GITHUB_CLIENT_ID=
WATEREXPERT_GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allow-list. Never use `*` together with credentials.
WATEREXPERT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WATEREXPERT_CORS_ALLOW_CREDENTIALS=1

# ---------------------------------------------------------------------------
# Upload guardrails
# ---------------------------------------------------------------------------
WATEREXPERT_MAX_UPLOAD_BYTES=536870912
WATEREXPERT_MAX_COMPRESSION_RATIO=120.0

# ---------------------------------------------------------------------------
# Task centre
# ---------------------------------------------------------------------------
# Only one scheduler may run at a time; keep a single app replica unless you
# know the multi-instance constraint (see docs).
WATEREXPERT_MAX_CONCURRENT_JOBS=2
WATEREXPERT_JOB_TIMEOUT_SECONDS=21600

# ---------------------------------------------------------------------------
# Data lifecycle / retention (0 disables a rule)
# ---------------------------------------------------------------------------
WATEREXPERT_JOB_RUN_RETENTION_DAYS=30
WATEREXPERT_REPORT_RETENTION_DAYS=365
WATEREXPERT_UPLOAD_RETENTION_DAYS=180
WATEREXPERT_MIN_FREE_DISK_BYTES=2147483648
WATEREXPERT_DATA_FRESHNESS_WARNING_DAYS=7

# ---------------------------------------------------------------------------
# Notifications (event handling: WeCom / DingTalk / Slack webhook)
# ---------------------------------------------------------------------------
WATEREXPERT_NOTIFICATION_WEBHOOK=

# ---------------------------------------------------------------------------
# Realtime validation (Aliyun national surface-water API)
# ---------------------------------------------------------------------------
WATEREXPERT_REALTIME_APPCODE=
# Legacy alias for the same value.
ALIYUN_APPCODE=

# ---------------------------------------------------------------------------
# Knowledge-graph LLM (DashScope compatible)
# ---------------------------------------------------------------------------
WATEREXPERT_KG_LLM_API_KEY=
WATEREXPERT_KG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WATEREXPERT_KG_LLM_MODEL=qwen-plus
